# CarburFlow — variables d'environnement
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app,.ngrok.app,.ngrok.io
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Origines CSRF supplémentaires (optionnel ; TRUST_NGROK_ORIGINS couvre *.ngrok*)
# CSRF_TRUSTED_ORIGINS=https://xxxx.ngrok-free.app

# Local (SQLite via core.settings.dev) — rien à renseigner
# Docker / prod (core.settings.prod) :
# DB_NAME=carburflow
# DB_USER=carburflow
# DB_PASSWORD=carburflow
# DB_HOST=db
# DB_PORT=5432
# SECURE_SSL_REDIRECT=false
# TRUST_NGROK_ORIGINS=true
# USE_X_FORWARDED_HOST=true
