# ============================================================
# CarburFlow — Variables d'environnement (exemple)
# Copier ce fichier en `.env` puis adapter les valeurs.
# Ne JAMAIS committer le vrai .env (déjà dans .gitignore).
# ============================================================

# --- Django ---
# settings utilisés : core.settings.dev (local) / core.settings.prod (Docker)
DJANGO_SETTINGS_MODULE=core.settings.dev
# OBLIGATOIRE en production (le serveur refuse de démarrer sans, cf. prod.py)
SECRET_KEY=change-me-avec-une-longue-chaine-aleatoire
# NOTE : DEBUG n'est PAS piloté par une variable d'env — il est fixé dans les
# settings : core.settings.dev -> True, core.settings.prod -> False.
# Choisissez le mode via DJANGO_SETTINGS_MODULE ci-dessus.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=
# Dérivés ngrok / tunnels (dev)
TRUST_NGROK_ORIGINS=false

# --- PostgreSQL (docker-compose.prod.yml) ---
DB_NAME=carburflow
DB_USER=carburflow
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# --- Sécurité HTTP (prod) ---
# true en prod derrière HTTPS, laisser false pour du Docker local en HTTP
SECURE_SSL_REDIRECT=false

# --- Amorçage données (entrypoint Docker) ---
RUN_SEED=1
RUN_IMPORT_FORCE=0

# --- Frontend ---
# Vide (recommandé, défaut compose) = chemins relatifs /api — proxy Vite en dev,
# nginx en Docker (requis pour ngrok). URL absolue seulement si API sur autre hôte.
VITE_API_BASE_URL=